		"main": [
			"com.mcsource.McSource"
		],
		"client": [
			"com.mcsource.client.McSourceClient"
		]
	},
	"mixins": [
		"mcsource.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
